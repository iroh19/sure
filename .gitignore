data/balık_videolar/
*.MOV
*.mp4
*.avi

# ─── Dataset görselleri (büyük) — Releases/Drive linki ────
data/sure_dataset/
data/ogretmen_dataset/

# ─── Model ağırlıkları (büyük binary) — Releases'a yükle ──
# Base ağırlıklar ultralytics'ten otomatik iner; eğitilmiş
# ağırlıkları GitHub Release olarak ekle, README'de linkle.
*.pt
sure_models/**/weights/

# MLflow tracking store and artefacts — regenerate with
#   python -m mlops.tracking --backfill
mlops/mlflow.db
mlops/artifacts/
mlops/last_backfill.json
mlops/recent_window.json

# Export artefacts: derived from weights, regenerate with
#   python vision-service/export_bench.py
sure_models/**/export/
*.onnx
*.torchscript
*.mlpackage/
*.engine
llm-service/sure-aqua-adapter*/
llm-service/test-adapter/

# ─── Ultralytics eğitim artefaktları (opsiyonel: tutulabilir) ──
